# Copie este arquivo para .env e preencha.
# Banco SQLite (o caminho é relativo à pasta prisma/). O repositório já traz prisma/dev.db com o seed de apresentação.
DATABASE_URL="file:./dev.db"

# Chave da Featherless (https://featherless.ai). Sem ela, a IA usa um texto de fallback e a demo funciona offline.
FEATHERLESS_API_KEY=""

# Modelos (opcionais; estes são os padrões).
# FEATHERLESS_MODEL="Qwen/Qwen2.5-7B-Instruct"
# FEATHERLESS_MENTOR_MODEL="deepseek-ai/DeepSeek-V3-0324"
# FEATHERLESS_MENTOR_FALLBACK_MODEL="Qwen/Qwen2.5-32B-Instruct"

# "Hoje" da aplicação, para apresentar num dia letivo (o seed foi gerado para 2026-11-03, uma terça).
DEMO_TODAY="2026-11-03"
